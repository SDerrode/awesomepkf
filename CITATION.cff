version: 2.15.0
date-released: "2026-08-16"
license: AGPL-3.0-only
repository-code: "https://github.com/SDerrode/awesomepkf"
url: "https://pypi.org/project/awesomepkf/"
keywords:
  - Kalman filter
  - pairwise Markov model
  - Kalman smoother
  - nonlinear filtering
  - unscented Kalman filter
  - expectation-maximization
  - time series
  - signal processing
